    "Apple didn't accept the key. Check the Issuer ID, the Key ID and the .p8 file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple hat den Schlüssel nicht angenommen. Prüfe Issuer-ID, Schlüssel-ID und die .p8-Datei."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple n’a pas accepté la clé. Vérifiez l’ID de l’émetteur, l’ID de clé et le fichier .p8."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleがキーを受け付けませんでした。Issuer ID、キーID、.p8ファイルを確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 未接受该密钥。请检查 Issuer ID、密钥 ID 和 .p8 文件。"
          }
        }
      }
    },
    "Apple is preparing the first store analytics. They usually arrive one to two days after the first launch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple bereitet die ersten Store-Analysen vor. Sie kommen meist ein bis zwei Tage nach dem ersten Start."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple prépare les premières analyses App Store. Elles arrivent en général un à deux jours après le premier lancement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleが最初のストアのアナリティクスを準備中です。通常、初回起動から1〜2日で届きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 正在准备首批商店分析数据，通常会在首次启动后一到两天内送达。"
          }
        }
      }
    },
    "Apple is reviewing it now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple prüft sie gerade."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple l’examine en ce moment."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleが現在審査中です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 正在审核。"
          }
        }
      }
    },
    "Apple pays each country in its own currency. The totals are converted with the European Central Bank's daily rates." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple rechnet jedes Land in seiner Währung ab. Die Summen werden mit den Tageskursen der Europäischen Zentralbank umgerechnet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple paie chaque pays dans sa propre devise. Les totaux sont convertis aux taux du jour de la Banque centrale européenne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleは国ごとにその国の通貨で支払います。合計は欧州中央銀行の日次レートで換算されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 以各国家或地区的货币结算。合计按欧洲中央银行的每日汇率换算。"
          }
        }
      }
    },
    "Apple publishes a month's sales summary a few days after it ends." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple veröffentlicht die Verkaufsübersicht eines Monats einige Tage nach seinem Ende."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple publie le récapitulatif des ventes d’un mois quelques jours après sa fin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleは月の売上概要を月末の数日後に公開します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 会在月末几天后发布当月的销售摘要。"
          }
        }
      }
    },
    "Apple's financial report" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apples Finanzbericht"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapport financier d’Apple"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleの財務レポート"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 财务报告"
          }
        }
      }
    },
    "Apple's newest report: %@. Each day's report arrives the next morning, Pacific time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apples neuester Bericht: %@. Der Bericht eines Tages kommt am nächsten Morgen, pazifischer Zeit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dernier rapport d’Apple : %@. Le rapport d’une journée arrive le lendemain matin, heure du Pacifique."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleの最新レポート：%@。各日のレポートは翌朝（太平洋時間）に届きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 最新报告：%@。每天的报告在次日早晨（太平洋时间）送达。"
          }
        }
      }
    },
    "Apple's store analytics arrive a day or two after the sales, the first ones one to two days after you connect." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apples Store-Analysen kommen ein, zwei Tage nach den Verkäufen, die ersten ein bis zwei Tage nach dem Verbinden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les analyses App Store d’Apple arrivent un ou deux jours après les ventes, les premières un à deux jours après la connexion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleのストアのアナリティクスは売上の1〜2日後に届きます。最初のものは接続から1〜2日後です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 的商店分析数据比销售数据晚一两天，首批数据在连接后一到两天内送达。"
          }
        }
      }
