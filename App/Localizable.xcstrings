    "Active subscriptions as of Apple's newest report. Per month: what the paid ones bring in at their standard price." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktive Abonnements laut Apples neuestem Bericht. Pro Monat: was die bezahlten zum Standardpreis einbringen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnements actifs selon le dernier rapport d’Apple. Par mois : ce que rapportent les abonnements payants à leur prix standard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleの最新レポート時点のアクティブなサブスクリプション。月額：有料のものが標準価格でもたらす収益。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "截至 Apple 最新报告的有效订阅。每月：付费订阅按标准价格带来的收益。"
          }
        }
      }
    },
