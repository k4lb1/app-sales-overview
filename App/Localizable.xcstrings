    "1. In App Store Connect, open Users and Access › Integrations › Team Keys." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Öffne in App Store Connect „Benutzer und Zugriff“ › „Integrationen“ › „Teamschlüssel“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Dans App Store Connect, ouvrez Utilisateurs et accès › Intégrations › Clés d’équipe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. App Store Connectで「ユーザとアクセス」›「統合」›「チームキー」を開きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 在 App Store Connect 中打开“用户和访问” ›“集成” ›“团队密钥”。"
          }
        }
      }
    },
    "180 days" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "180 Tage"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "180 jours"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "180日"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "180 天"
          }
        }
      }
    },
    "2. Generate a key with the Finance or Admin role and download it (.p8, only possible once)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Erzeuge einen Schlüssel mit der Rolle „Finanzen“ oder „Admin“ und lade ihn herunter (.p8, geht nur einmal)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Générez une clé avec le rôle Finances ou Admin et téléchargez-la (.p8, possible une seule fois)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 「財務」または「管理」の役割でキーを生成し、ダウンロードします（.p8、一度だけ可能）。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 生成一个具有“财务”或“管理”职能的密钥并下载（.p8，只能下载一次）。"
          }
        }
      }
    },
    "3. Copy the Issuer ID (above the list) and the Key ID (in the key's row)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Kopiere die Issuer-ID (über der Liste) und die Schlüssel-ID (in der Zeile des Schlüssels)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Copiez l’ID de l’émetteur (au-dessus de la liste) et l’ID de clé (sur la ligne de la clé)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Issuer ID（リストの上）とキーID（キーの行）をコピーします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. 复制 Issuer ID（列表上方）和密钥 ID（密钥所在行）。"
          }
        }
      }
    },
    "30 days" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 Tage"
          }
        },
        "fr" : {
