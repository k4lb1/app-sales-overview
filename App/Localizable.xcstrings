    "App Sales Overview reads your figures straight from App Store Connect and puts every app on one screen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Sales Overview liest deine Zahlen direkt aus App Store Connect und zeigt jede App auf einem Bildschirm."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Sales Overview lit vos chiffres directement dans App Store Connect et réunit toutes vos apps sur un seul écran."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Sales OverviewはApp Store Connectから直接数値を読み込み、すべてのアプリをひとつの画面に表示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Sales Overview 直接从 App Store Connect 读取你的数据，把所有 App 放在一个屏幕上。"
          }
        }
      }
    },
