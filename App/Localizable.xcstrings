    },
    "4. The vendor number is in Payments and Financial Reports, top left." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. Die Anbieternummer steht unter „Zahlungen und Finanzberichte“ oben links."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. Le numéro de fournisseur se trouve dans Paiements et rapports financiers, en haut à gauche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. ベンダー番号は「支払いと財務レポート」の左上にあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. 供应商编号位于“付款和财务报告”的左上角。"
          }
        }
      }
    },
